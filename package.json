{
  "name": "return",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "generate": "node src/router/generate.ts --routes spec/src/routes --out spec/src/routes.gen.ts",
    "generate:check": "node src/router/generate.ts --routes spec/src/routes --out spec/src/routes.gen.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "node src/router/generate.ts --routes spec/src/routes --out spec/src/routes.gen.ts --check && tsc --noEmit && node --test test/**/*.test.ts spec/test/**/*.test.ts",
    "start": "node spec/src/main.ts",
    "dev": "node spec/src/dev-host.ts"
  },
  "dependencies": {
    "effect": "4.1.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
